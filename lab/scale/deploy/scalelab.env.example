# /etc/default/scalelab: environment for scalelab.service
SCALE_CIDR=10.66.0.0/18
SCALE_HOSTS=1500
SCALE_SEED=1337
# Interface the scanner's packets arrive on (Hetzner private network: enp7s0).
SCALE_UPLINK=enp7s0
SCALE_NETEM=delay 3ms 2ms distribution normal loss 0.1%
# Bind the control API to the private address only.
SCALE_CONTROL=10.0.0.3:9900
SCALE_TOD_HOURS=07-19
SCALE_TZ=Europe/Warsaw
SCALE_TRUTH_DIR=/var/lib/scalelab
